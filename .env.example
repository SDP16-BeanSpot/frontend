# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 gitignore 됩니다)
# Expo 는 EXPO_PUBLIC_ 접두사가 붙은 값만 앱 번들에 주입합니다.
# 값을 바꾼 뒤에는 Metro 를 --clear 로 재시작해야 반영됩니다: npx expo start --clear

# ── 백엔드 ────────────────────────────────────────────────
# 비워두면 앱이 목(mock) 데이터로 동작합니다.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_CHAT_BASE_URL=
EXPO_PUBLIC_WS_URL=
# 로그인 없이 API 를 찔러볼 때만 쓰는 개발용 토큰. 평소에는 비워두세요.
EXPO_PUBLIC_AUTH_TOKEN=

# ── 카카오 ────────────────────────────────────────────────
# [1] 네이티브 앱 키 — 카카오 로그인 + Android 지도 SDK.
#     Kakao Developers > 내 애플리케이션 > 앱 키 > 네이티브 앱 키
#     iOS URL 스킴(kakao{네이티브앱키})이 이 값으로 만들어지므로,
#     바꾸면 ios/BeanSpot/Info.plist 의 CFBundleURLSchemes 도 함께 고쳐야 합니다.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# [2] JavaScript 키 — iOS 지도(WebView 의 Kakao Maps JS SDK) 전용. [1]과 다른 키입니다.
#     Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
EXPO_PUBLIC_KAKAO_MAP_KEY=

# [3] iOS 지도 WebView 의 origin.
#     Kakao JS SDK 는 요청 Referer 를 콘솔에 등록된 웹 도메인과 대조합니다.
#     Kakao Developers > 앱 설정 > 플랫폼 > Web > 사이트 도메인 에 등록한 값과
#     정확히 같아야 하며, 다르면 지도가 빈 화면으로 뜹니다.
EXPO_PUBLIC_KAKAO_MAP_WEB_ORIGIN=https://localhost
